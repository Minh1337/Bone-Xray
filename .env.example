# Copy to .env at the project root. Groq Free has request/token limits.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=35
GROQ_MAX_OUTPUT_TOKENS=2400

# Optional OpenAI configuration, used only with LLM_PROVIDER=openai.
# ChatGPT Plus is separate from API billing/credits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=35
OPENAI_MAX_OUTPUT_TOKENS=1600
