# Free OpenRouter model first; the single fixed paid model is only a slow/error fallback.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_PAID_FALLBACK_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_FREE_FALLBACK_AFTER_SECONDS=15
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_TIMEOUT_SECONDS=35
OPENROUTER_MAX_OUTPUT_TOKENS=1600
# Enable only after confirming this Groq account is still on the Free Plan.
GROQ_FALLBACK_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
